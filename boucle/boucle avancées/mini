const prompt = require('prompt-sync')();
function affichetablecalcule(){
    do {
        console.log("le tableau calcule : ");
        parseInt(prompt("1-addition"));
        parseInt(prompt("2-multiplication"));
        parseInt(prompt("3-division"));
        parseInt(prompt("4-subtraction"));
        parseInt(prompt("5-QUITTE"));
       let choisis = parseInt(prompt("choisis"));

       switch(choisis){
        case 1 :
           console.log("1-addition");
